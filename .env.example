# Copy to .env for local runtime settings and optional explicit resolver overrides.
# Do not put secrets here.
APPDATA_ROOT=/mnt/user/appdata/chatgpt-ce-workstation
PROJECTS_ROOT=/mnt/user/projects
NOVNC_BIND_IP=0.0.0
NOVNC_PORT=6080
TZ_VALUE=Europe/Zurich
SHM_SIZE=1gb

IMAGE_NAME=chatgpt-ce-workstation
IMAGE_TAG=local
CONTAINER_NAME=chatgpt-ce-workstation

# Dedicated BuildKit namespace and bounded post-success cache retention.
WORKSTATION_BUILDER_NAME=chatgpt-ce-workstation
WORKSTATION_BUILD_CACHE_MAX_USED_SPACE=24gb
WORKSTATION_BUILD_CACHE_RESERVED_SPACE=8gb

CODEX_UID=99
CODEX_GID=100

# Resolver policy defaults to current trusted stable/current upstreams.
# Uncomment only for an explicit recovery/debug/compatibility override. The
# resulting resolution manifest records every override.
CE_REF=main
# UPSTREAM_CE_COMMIT=
# UPSTREAM_UBUNTU_BASE_DIGEST=
# AGENT_WORKSPACE_VERSION=
# S6_OVERLAY_VERSION=
# CODEX_CHATGPT_WEB_VERSION=
MUSE_INSTALLER_URL=https://dev.meta.ai/install.sh
# MUSE_INSTALLER_SHA256=

# Native Codex upstream supplied to codex-chatgpt-web. The fork owns its
# Codex-LB credential loading; do not put the key in this file.
# Example: http://127.0.0.1:2455/backend-api/codex
CODEX_CHATGPT_WEB_NATIVE_UPSTREAM=

# The workstation-wide ~/.codex/AGENTS.md policy was explicitly accepted.
INSTALL_GLOBAL_AGENTS=1
