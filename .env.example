# Copy to .env only when local overrides are useful. Do not put secrets here.
APPDATA_ROOT=/mnt/user/appdata/chatgpt-ce-workstation
PROJECTS_ROOT=/mnt/user/projects
NOVNC_BIND_IP=0.0.0.0
NOVNC_PORT=6080
TZ_VALUE=Europe/Zurich
SHM_SIZE=1gb

IMAGE_NAME=chatgpt-ce-workstation
IMAGE_TAG=local
CONTAINER_NAME=chatgpt-ce-workstation

CODEX_UID=99
CODEX_GID=100
CE_REF=main
S6_OVERLAY_VERSION=3.2.3.2
AGENT_WORKSPACE_VERSION=0.3.2
# Leave empty to resolve the latest codex-chatgpt-web release when the relevant
# image layer is rebuilt.
CODEX_CHATGPT_WEB_VERSION=

# Optional native Codex upstream. Leave empty to use the official ChatGPT Codex
# backend. Store the Codex-LB API key with scripts/set-codex-lb-key.sh, not here.
CODEX_CHATGPT_WEB_NATIVE_UPSTREAM=

# Muse Code is image-managed. The installer URL follows Meta's current public
# stable installer. Leave SHA-256 empty until a verified current installer hash
# is deliberately pinned; the build always prints the observed hash.
MUSE_INSTALLER_URL=https://dev.meta.ai/install.sh
MUSE_INSTALLER_SHA256=

# The workstation-wide ~/.codex/AGENTS.md policy was explicitly accepted.
INSTALL_GLOBAL_AGENTS=1

# Normally leave this alone. scripts/update.sh overrides it with a fresh value
# so remote CE/codex-chatgpt-web/Muse source layers cannot be satisfied by stale cache.
UPSTREAM_REFRESH=bootstrap
