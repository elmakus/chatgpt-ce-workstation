# syntax=docker/dockerfile:1

ARG UBUNTU_BASE=ubuntu:24.04
FROM ${UBUNTU_BASE} AS openai-resolver

ARG CE_REPOSITORY=https://github.com/ilysenko/codex-desktop-linux.git
ARG CE_COMMIT
ARG OPENAI_ARCH=amd64

RUN set -eux; \
    test -n "${CE_COMMIT}"; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates git gnupg nodejs; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    git init /tmp/ce; \
    git -C /tmp/ce remote add origin "${CE_REPOSITORY}"; \
    git -C /tmp/ce fetch --depth=1 origin "${CE_COMMIT}"; \
    test "$(git -C /tmp/ce rev-parse FETCH_HEAD)" = "${CE_COMMIT}"; \
    git -C /tmp/ce checkout --detach FETCH_HEAD

RUN set -eux; \
    mkdir -p /out /tmp/openai-metadata; \
    node /tmp/ce/scripts/lib/upstream-linux-package.js \
      --output-dir /tmp/openai-metadata \
      --metadata /out/openai-package.json \
      --key-base64 /tmp/ce/assets/openai-codex-linux-repository-key.gpg.base64 \
      --arch "${OPENAI_ARCH}" \
      --metadata-only; \
    test -s /out/openai-package.json

FROM scratch AS openai-metadata
COPY --from=openai-resolver /out/openai-package.json /openai-package.json
