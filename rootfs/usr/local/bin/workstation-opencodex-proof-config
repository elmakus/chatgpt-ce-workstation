#!/usr/bin/env python3
from __future__ import annotations

import argparse
import ipaddress
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
from urllib.parse import urlsplit

PROVIDER_IDS = ("codex-lb", "cliproxyapi", "chatgpt-web")
ALLOWED_ADAPTERS = {"openai-chat", "openai-responses"}
PROVIDER_FIELDS = {"adapter", "baseUrl", "models", "allowPrivateNetwork"}
META_MODELS = ("muse-spark-1.3", "muse-spark-1.3-contributor")
META_EFFORTS = ("minimal", "low", "medium", "high", "xhigh")
META_CONTEXT_WINDOW = 1_048_576


class ConfigError(ValueError):
    pass


def canonical(path: str | Path) -> Path:
    return Path(path).expanduser().resolve(strict=False)


def is_within(path: Path, root: Path) -> bool:
    return path == root or root in path.parents


def proof_paths() -> tuple[Path, Path, Path, Path, Path]:
    raw_home = os.environ.get("HOME", "").strip()
    if not raw_home:
        raise ConfigError("HOME is required")
    home = canonical(raw_home)
    proof_root = canonical(os.environ.get(
        "OPENCODEX_PROOF_ROOT",
        str(home / ".local/state/chatgpt-ce-workstation/opencodex-proof"),
    ))
    proof_home = canonical(os.environ.get("OPENCODEX_PROOF_HOME", str(proof_root / "opencodex")))
    proof_codex_home = canonical(os.environ.get(
        "OPENCODEX_PROOF_CODEX_HOME",
        str(proof_root / "codex-home"),
    ))
    production_opencodex_home = canonical(home / ".opencodex")
    production_codex_home = canonical(home / ".codex")

    for candidate, label in ((proof_home, "OpenCodex"), (proof_codex_home, "Codex")):
        if is_within(candidate, production_opencodex_home) or is_within(candidate, production_codex_home):
            raise ConfigError(f"proof {label} home overlaps a production home")
    if proof_home == proof_codex_home:
        raise ConfigError("proof OpenCodex and Codex homes must be distinct")

    return proof_root, proof_home, proof_codex_home, production_opencodex_home, production_codex_home


def require_safe_config_path(raw: str | None, disposable: bool) -> Path:
    proof_root, proof_home, _, production_opencodex_home, production_codex_home = proof_paths()
    path = canonical(raw) if raw else canonical(proof_home / "config.json")
    if is_within(path, production_opencodex_home) or is_within(path, production_codex_home):
        raise ConfigError("proof config path overlaps a production home")
    if not is_within(path, proof_root) and not disposable:
        raise ConfigError("config outside the proof root requires --disposable")
    return path


def require_provider_url(value: object, provider_id: str, allow_private: bool) -> str:
    if not isinstance(value, str) or not value or value != value.strip():
        raise ConfigError(f"{provider_id}.baseUrl must be a nonblank trimmed string")
    parsed = urlsplit(value)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc or parsed.hostname is None:
        raise ConfigError(f"{provider_id}.baseUrl must be an absolute http(s) URL")
    if parsed.username is not None or parsed.password is not None:
        raise ConfigError(f"{provider_id}.baseUrl must not contain credentials")
    if parsed.query or parsed.fragment:
        raise ConfigError(f"{provider_id}.baseUrl must not contain a query string or fragment")

    host = parsed.hostname.lower()
    literal_private = host == "localhost" or host.endswith(".localhost")
    try:
        ip = ipaddress.ip_address(host)
        literal_private = literal_private or ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_reserved
    except ValueError:
        pass
    if literal_private and not allow_private:
        raise ConfigError(f"{provider_id}.baseUrl is private/loopback; set allowPrivateNetwork=true explicitly")
    return value


def require_models(value: object, provider_id: str) -> list[str]:
    if not isinstance(value, list) or not value:
        raise ConfigError(f"{provider_id}.models must be a non-empty array")
    models: list[str] = []
    for item in value:
        if not isinstance(item, str) or not item or item != item.strip():
            raise ConfigError(f"{provider_id}.models entries must be nonblank trimmed strings")
        if any(ord(ch) < 32 for ch in item):
            raise ConfigError(f"{provider_id}.models entries must not contain control characters")
        models.append(item)
    if len(models) != len(set(models)):
        raise ConfigError(f"{provider_id}.models must not contain duplicates")
    return models


def load_spec(path: str) -> dict[str, object]:
    try:
        raw = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ConfigError(f"cannot read proof spec: {exc}") from exc
    if not isinstance(raw, dict) or set(raw) != {"version", "providers"}:
        raise ConfigError("proof spec must contain exactly version and providers")
    if raw["version"] != 1:
        raise ConfigError("proof spec version must be 1")
    providers = raw["providers"]
    if not isinstance(providers, dict) or set(providers) != set(PROVIDER_IDS):
        raise ConfigError("proof spec providers must be exactly codex-lb, cliproxyapi, and chatgpt-web")
    return raw


def custom_provider(provider_id: str, raw: object) -> dict[str, object]:
    if not isinstance(raw, dict) or set(raw) != PROVIDER_FIELDS:
        raise ConfigError(
            f"{provider_id} must contain exactly adapter, baseUrl, models, and allowPrivateNetwork"
        )
    adapter = raw["adapter"]
    if adapter not in ALLOWED_ADAPTERS:
        raise ConfigError(f"{provider_id}.adapter must be openai-chat or openai-responses")
    allow_private = raw["allowPrivateNetwork"]
    if not isinstance(allow_private, bool):
        raise ConfigError(f"{provider_id}.allowPrivateNetwork must be boolean")
    base_url = require_provider_url(raw["baseUrl"], provider_id, allow_private)
    models = require_models(raw["models"], provider_id)
    return {
        "adapter": adapter,
        "authMode": "key",
        "baseUrl": base_url,
        "defaultModel": models[0],
        "liveModels": False,
        "models": models,
        **({"allowPrivateNetwork": True} if allow_private else {}),
    }


def meta_muse_provider() -> dict[str, object]:
    effort_map = {effort: effort for effort in META_EFFORTS}
    return {
        "adapter": "openai-responses",
        "authMode": "oauth",
        "baseUrl": "https://api.meta.ai/v1",
        "defaultModel": META_MODELS[0],
        "headers": {"x-api-version": "1.0.0"},
        "liveModels": False,
        "models": list(META_MODELS),
        "modelContextWindows": {model: META_CONTEXT_WINDOW for model in META_MODELS},
        "modelInputModalities": {model: ["text", "image"] for model in META_MODELS},
        "modelReasoningEffortMap": {model: dict(effort_map) for model in META_MODELS},
        "modelReasoningEfforts": {model: list(META_EFFORTS) for model in META_MODELS},
    }


def render_config(spec: dict[str, object]) -> dict[str, object]:
    providers_raw = spec["providers"]
    assert isinstance(providers_raw, dict)
    providers = {
        provider_id: custom_provider(provider_id, providers_raw[provider_id])
        for provider_id in PROVIDER_IDS
    }
    providers["meta-muse"] = meta_muse_provider()
    return {
        "codexNativeInjection": False,
        "codexNativeSteering": False,
        "defaultProvider": "codex-lb",
        "providers": providers,
    }


def atomic_write_json(path: Path, value: dict[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        path.parent.chmod(0o700)
    except OSError:
        pass
    payload = json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
    tmp = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    try:
        with open(tmp, "x", encoding="utf-8") as handle:
            os.chmod(tmp, 0o600)
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
        os.chmod(path, 0o600)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def render(args: argparse.Namespace) -> int:
    config_path = require_safe_config_path(args.output, args.disposable)
    config = render_config(load_spec(args.spec))
    atomic_write_json(config_path, config)
    print(config_path)
    return 0


def validate(args: argparse.Namespace) -> int:
    config_path = require_safe_config_path(args.config, args.disposable)
    if not config_path.is_file():
        raise ConfigError(f"config does not exist: {config_path}")
    _, proof_home, proof_codex_home, _, _ = proof_paths()
    proof_home.mkdir(parents=True, exist_ok=True)
    proof_codex_home.mkdir(parents=True, exist_ok=True)
    proof_home.chmod(0o700)
    proof_codex_home.chmod(0o700)
    ocx = shutil.which("ocx")
    if not ocx:
        raise ConfigError("ocx executable not found")
    env = os.environ.copy()
    env["OPENCODEX_HOME"] = str(proof_home)
    env["CODEX_HOME"] = str(proof_codex_home)
    completed = subprocess.run(
        [ocx, "config", "validate", str(config_path), "--json"],
        env=env,
        check=False,
    )
    return completed.returncode


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        description="Render or validate an isolated, secret-free OpenCodex provider proof configuration."
    )
    sub = root.add_subparsers(dest="command", required=True)

    render_parser = sub.add_parser("render")
    render_parser.add_argument("--spec", required=True)
    render_parser.add_argument("--output")
    render_parser.add_argument("--disposable", action="store_true")
    render_parser.set_defaults(func=render)

    validate_parser = sub.add_parser("validate")
    validate_parser.add_argument("--config")
    validate_parser.add_argument("--disposable", action="store_true")
    validate_parser.set_defaults(func=validate)
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        return args.func(args)
    except ConfigError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
