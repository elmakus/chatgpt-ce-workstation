#!/usr/bin/env bash
set -Eeuo pipefail

export DISPLAY="${DISPLAY:-:1}"
keyring_session_ready="${KEYRING_SESSION_READY:-/run/workstation/keyring-session-ready}"

curl -fsS --max-time 3 http://127.0.0.1:6080/vnc.html >/dev/null
xdpyinfo -display "$DISPLAY" >/dev/null 2>&1
pgrep -x openbox >/dev/null
pgrep -x x11vnc >/dev/null
pgrep -f 'websockify.*6080.*127\.0\.0\.1:5900' >/dev/null

test -f "$keyring_session_ready"

exit 0
