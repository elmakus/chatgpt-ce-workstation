# Minimal workstation panel for the headless Openbox/noVNC session.
# Keep this intentionally small: launchers, running tasks, tray and clock.
panel_items = LTSC
panel_size = 100% 38
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_dock = 1
wm_menu = 1

launcher_icon_size = 24
launcher_padding = 6 4 6
launcher_item_app = /usr/local/share/applications/chatgpt-ce.desktop
launcher_item_app = /usr/local/share/applications/codex-web-gpt.desktop
launcher_item_app = /usr/share/applications/xterm.desktop

taskbar_mode = multi_desktop
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 220 32
task_padding = 6 3 6

systray_padding = 6 3 6
clock_format = %H:%M
clock_padding = 8 0
