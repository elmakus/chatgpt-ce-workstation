#!/command/with-contenv bash
set -Eeuo pipefail

home=/home/codex
codex_group="$(id -g codex)"
config_root="$home/.config"
config_dir="$config_root/workstation"
local_root="$home/.local"
local_share="$local_root/share"
applications_dir="$local_share/applications"
documents_root="$home/Documents"
ce_projects_path="$documents_root/ChatGPT"
vnc_auth_file="$config_dir/vnc.pass"
vnc_secret_file=/run/secrets/novnc-password
keyring_secret_file=/run/secrets/keyring-password
runtime_secret_dir=/run/workstation
runtime_keyring_secret="$runtime_secret_dir/keyring-migration-password"
keyring_marker="$config_dir/keyring-passwordless-v2"
keyring_dir="$local_share/keyrings"
keyring_backup="$local_share/keyrings.pre-passwordless-v2"

# These directories are created by root during container init, but the persistent
# home is a normal user home. Explicitly hand every root-created parent back to
# codex so Electron/CE and other user applications can create their own state.
mkdir -p "$home" "$config_dir" "$applications_dir" "$documents_root" "$runtime_secret_dir"
chown codex:"$codex_group" \
  "$home" \
  "$config_root" \
  "$config_dir" \
  "$local_root" \
  "$local_share" \
  "$applications_dir" \
  "$documents_root" \
  "$runtime_secret_dir" 2>/dev/null || true
chmod 0700 "$config_dir" "$runtime_secret_dir"

# D26 v2 repair: legacy root-owned keyring files can be unreadable to the codex
# desktop after historical secondary root keyring sessions. Preserve the exact
# pre-attempt directory before repairing active ownership.
# shellcheck disable=SC1091
source /opt/workstation/bin/keyring-migration-lib.sh
prepare_keyring_passwordless_v2 \
  "$home" "$(id -u codex)" "$codex_group" \
  "$keyring_marker" "$keyring_dir" "$keyring_backup"

# PROJECTS_ROOT is mounted directly at CE's native Create Project location.
# There is intentionally no /workspace alias or symlink: this path is the single
# canonical project root both for CE and for shell/Remote tasks.
if [[ ! -d "$ce_projects_path" ]]; then
  echo "[init] CE project root is not mounted: $ce_projects_path" >&2
  exit 1
fi
if ! runuser -u codex -- test -w "$ce_projects_path"; then
  echo "[init] CE project root is not writable by codex: $ce_projects_path" >&2
  echo "[init] run scripts/init-unraid.sh on the host to repair root permissions." >&2
  exit 1
fi

if [[ -r "$vnc_secret_file" ]]; then
  password="$(cat "$vnc_secret_file")"
  if [[ -z "$password" ]]; then
    echo "[init] $vnc_secret_file is empty" >&2
    exit 1
  fi
  x11vnc -storepasswd "$password" "$vnc_auth_file" >/dev/null
  chown codex:"$codex_group" "$vnc_auth_file"
  chmod 0600 "$vnc_auth_file"
elif [[ ! -f "$vnc_auth_file" ]]; then
  echo "[init] no VNC password available." >&2
  echo "[init] mount /run/secrets/novnc-password or restore $vnc_auth_file from persistent home." >&2
  exit 1
fi

# D26 makes the persistent keyring passwordless. V2 deliberately ignores any
# stale v1 completion marker from the failed production path. A legacy non-empty
# secret remains a one-time migration credential until v2 succeeds.
rm -f "$runtime_keyring_secret"
if [[ ! -f "$keyring_marker" && -s "$keyring_secret_file" ]]; then
  install -m 0400 -o codex -g "$codex_group" "$keyring_secret_file" "$runtime_keyring_secret"
fi

# Workstation-wide Codex defaults are enabled by Compose after explicit user
# approval. Reconcile only the workstation-owned block. Exact known stock legacy
# prefixes may be migrated once; ambiguous or malformed content is left untouched.
global_agents="$home/.codex/AGENTS.md"
if [[ "${INSTALL_GLOBAL_AGENTS:-0}" == "1" ]]; then
  mkdir -p "$home/.codex"
  chown codex:"$codex_group" "$home/.codex"
  python3 /opt/workstation/bin/reconcile-global-agents.py \
    --target "$global_agents" \
    --payload /opt/workstation/defaults/AGENTS.md \
    --legacy /opt/workstation/defaults/AGENTS.legacy-pre-managed.md \
    --legacy /opt/workstation/defaults/AGENTS.legacy-workspace.md \
    --uid "$(id -u codex)" \
    --gid "$codex_group" \
    --mode 0644
fi

# These launchers are workstation-managed generated state, not user-authored
# configuration. Refresh them on every container start so a rebuilt image cannot
# leave stale persistent desktop entries behind.
install -m 0644 -o codex -g "$codex_group" \
  /usr/local/share/applications/codex-web-gpt.desktop \
  "$applications_dir/codex-web-gpt.desktop"

# Electron's shell.openExternal delegates OAuth/login links to the desktop URL
# handler. Chrome's own Linux sandbox is not usable inside this Unraid Docker
# boundary, just like CE's Electron sandbox, so expose a container-scoped browser
# launcher with --no-sandbox while keeping the Docker container unprivileged.
chrome_desktop="$applications_dir/google-chrome-workstation.desktop"
cat >"$chrome_desktop" <<'EOF'
[Desktop Entry]
Name=Google Chrome
Type=Application
Exec=/usr/bin/google-chrome --no-sandbox --user-data-dir=/home/codex/.config/google-chrome %U
Terminal=false
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
Categories=Network;WebBrowser;
EOF
chown codex:"$codex_group" "$chrome_desktop"
chmod 0644 "$chrome_desktop"

# Keep OAuth/web links deterministic after rebuilds and container recreation.
# These files live in the persistent home, so the setting also survives updates.
runuser -u codex -- env HOME="$home" XDG_DATA_HOME="$local_share" \
  xdg-mime default google-chrome-workstation.desktop x-scheme-handler/http
runuser -u codex -- env HOME="$home" XDG_DATA_HOME="$local_share" \
  xdg-mime default google-chrome-workstation.desktop x-scheme-handler/https
runuser -u codex -- env HOME="$home" XDG_DATA_HOME="$local_share" \
  xdg-mime default google-chrome-workstation.desktop text/html
